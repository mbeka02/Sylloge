# Development inputs. Copy to .env; injected shell variables take precedence.
# PORT is configuration, not a credential. No broker is used yet.
PORT=3000
APP_ENV=development
ROUTING_CONFIG_FILE=configs/routing.example.json
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=16384
SHUTDOWN_TIMEOUT=60s
MAX_ACTIVE_REQUESTS=128
RATE_LIMIT=1000
RATE_LIMIT_MAX_IPS=10000
RATE_LIMIT_IDLE_TIMEOUT=60s
TRUSTED_PROXIES=
RAW_LOGS_CAPACITY=10000
INGEST_BATCH_SIZE=50
ADMISSION_TIMEOUT=100ms
